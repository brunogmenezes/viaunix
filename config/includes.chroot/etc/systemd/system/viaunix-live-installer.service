[Unit]
Description=ViaUnix: sessao exclusiva do instalador (somente Live)
ConditionKernelCommandLine=boot=live
After=live-config.service
Wants=live-config.service
Before=display-manager.service gdm.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/viaunix-live-setup

[Install]
WantedBy=multi-user.target

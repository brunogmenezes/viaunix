#!/bin/bash
# ViaUnix - Assistente de rede do instalador (executa antes do Calamares).
#  1) Pergunta se a conexao sera cabeada ou Wi-Fi.
#  2) Wi-Fi: lista as redes (SSID), pede a senha e conecta via NetworkManager.
#  3) So avanca quando ha comunicacao com o servidor de provisionamento.
# Retorno: 0 = rede OK (segue para o Calamares); 1 = usuario cancelou.

CONF=/etc/viaunix/provision.conf
PROVISION_URL="http://172.16.152.2:8088/api/provision"
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"
HEALTH_URL="${PROVISION_URL%/api/provision}/health"

# true  = so avanca com comunicacao com o servidor (padrao)
# false = avanca assim que houver conexao de rede (o provisionamento tem fila offline)
REQUIRE_SERVER=true

TITLE="Instalação do ViaUnix"
ICON=/usr/share/pixmaps/viaunix-logo.png
SCAN_FILE=$(mktemp)
CONNECT_OUT=$(mktemp)
trap 'rm -f "$SCAN_FILE" "$CONNECT_OUT"' EXIT

zen() { zenity --title="$TITLE" --window-icon="$ICON" "$@"; }
nm() { sudo -n nmcli "$@"; }

server_ok() { curl -fsS --max-time 5 "$HEALTH_URL" >/dev/null 2>&1; }

wait_server() {
    [ "$REQUIRE_SERVER" = true ] || return 0
    local i
    for i in $(seq 1 10); do
        server_ok && return 0
        sleep 2
    done
    return 1
}

# Executa uma funcao em segundo plano mostrando barra de progresso; devolve o status dela
run_with_progress() {
    local text="$1"; shift
    "$@" &
    local pid=$!
    ( while kill -0 "$pid" 2>/dev/null; do sleep 0.5; done; echo 100 ) \
        | zen --progress --pulsate --auto-close --no-cancel --text="$text" >/dev/null 2>&1
    wait "$pid"
}

has_wifi() { nm -t -f TYPE device 2>/dev/null | grep -qx 'wifi'; }

scan_wifi() {
    nm radio wifi on >/dev/null 2>&1
    sudo -n rfkill unblock wifi >/dev/null 2>&1
    nm -t -f SIGNAL,SECURITY,SSID device wifi list --rescan yes > "$SCAN_FILE" 2>/dev/null
}

connect_wifi() {  # ssid senha oculta(0/1)
    local ssid="$1" pass="$2" hidden="$3"
    local -a args=(device wifi connect "$ssid")
    [ -n "$pass" ] && args+=(password "$pass")
    [ "$hidden" = 1 ] && args+=(hidden yes)
    nm connection delete id "$ssid" >/dev/null 2>&1
    nm "${args[@]}" > "$CONNECT_OUT" 2>&1
}

wired_flow() {
    while true; do
        if run_with_progress "Verificando o cabo de rede e a comunicação com o servidor..." wait_server; then
            return 0
        fi
        zen --question --width=460 --ok-label="Tentar novamente" --cancel-label="Voltar" \
            --text="Sem comunicação com o servidor.\n\nConecte o cabo de rede e tente novamente." || return 2
    done
}

wifi_flow() {
    if ! has_wifi; then
        zen --error --width=440 --text="Nenhum adaptador Wi-Fi foi detectado neste computador.\n\nUse a conexão por cabo de rede."
        return 2
    fi

    while true; do
        run_with_progress "Procurando redes Wi-Fi..." scan_wifi

        local -a rows=()
        local -A seen=() secmap=()
        local line sig sec ssid
        while IFS= read -r line; do
            IFS=: read -r sig sec ssid <<< "$line"
            ssid=${ssid//\\:/:}
            ssid=${ssid//\\\\/\\}
            [ -n "$ssid" ] || continue
            [ -n "${seen[$ssid]:-}" ] && continue
            seen[$ssid]=1
            secmap[$ssid]="$sec"
            rows+=("$ssid" "${sig}%" "${sec:-Aberta}")
        done < <(sort -t: -k1,1nr "$SCAN_FILE")
        rows+=("[ Atualizar lista ]" "" "" "[ Rede oculta... ]" "" "")

        local choice
        choice=$(zen --list --width=700 --height=460 \
            --text="Selecione a rede Wi-Fi para conectar este computador:" \
            --column="Rede (SSID)" --column="Sinal" --column="Segurança" "${rows[@]}") || return 2

        local hidden=0 need_pass=0 pass=""
        case "$choice" in
            "[ Atualizar lista ]") continue ;;
            "[ Rede oculta... ]")
                choice=$(zen --entry --text="Nome da rede oculta (SSID):") || continue
                [ -n "$choice" ] || continue
                hidden=1
                if zen --question --ok-label="Sim" --cancel-label="Não" --text="A rede \"$choice\" possui senha?"; then
                    need_pass=1
                fi
                ;;
            *)
                case "${secmap[$choice]:-}" in
                    *802.1X*)
                        zen --warning --width=480 --text="A rede \"$choice\" usa autenticação corporativa (802.1X), que não é suportada neste assistente.\n\nEscolha outra rede ou use o cabo de rede."
                        continue
                        ;;
                    ""|"--") need_pass=0 ;;
                    *) need_pass=1 ;;
                esac
                ;;
        esac

        if [ "$need_pass" = 1 ]; then
            pass=$(zen --entry --hide-text --text="Digite a senha da rede \"$choice\":") || continue
        fi

        if run_with_progress "Conectando a \"$choice\"..." connect_wifi "$choice" "$pass" "$hidden"; then
            if run_with_progress "Verificando a comunicação com o servidor..." wait_server; then
                return 0
            fi
            nm connection delete id "$choice" >/dev/null 2>&1
            zen --error --width=480 --text="Conectado à rede \"$choice\", mas sem comunicação com o servidor.\n\nVerifique se esta rede tem acesso ao servidor ou escolha outra."
        else
            nm connection delete id "$choice" >/dev/null 2>&1
            zen --error --no-markup --width=480 \
                --text="Não foi possível conectar a \"$choice\".\n\nVerifique a senha e o sinal da rede.\n\n$(tail -n 1 "$CONNECT_OUT")"
        fi
    done
}

while true; do
    mode=$(zen --list --radiolist --width=520 --height=300 \
        --text="<b>Bem-vindo ao instalador do ViaUnix</b>\n\nEste computador precisa de acesso à rede para ser registrado no servidor.\nComo ele será conectado?" \
        --column="Escolha" --column="Valor" --column="Conexão" \
        TRUE cabeada "Cabo de rede (Ethernet)" \
        FALSE wifi "Wi-Fi (rede sem fio)" \
        --hide-column=2 --print-column=2) || exit 1

    case "$mode" in
        cabeada) wired_flow; rc=$? ;;
        wifi)    wifi_flow;  rc=$? ;;
        *)       exit 1 ;;
    esac
    [ "$rc" -eq 0 ] && exit 0
done

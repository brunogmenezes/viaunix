#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ] || [ "$1" = disappear ]; then
    for f in /usr/lib/os-release /etc/issue; do
        if dpkg-divert --list "$f" | grep -q "viaunix-release"; then
            dpkg-divert --package viaunix-release --remove --rename "$f"
        fi
    done
fi
exit 0

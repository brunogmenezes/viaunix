#!/usr/bin/env python3
"""ViaUnix Agent 1.1.0 - telemetria rapida (5s), acoes remotas e autorizacao RustDesk."""

import glob
import json
import os
import pwd
import re
import secrets
import shutil
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request

CONF_PATH = "/etc/viaunix/provision.conf"
STATE_DIR = "/var/lib/viaunix-agent"
TOKEN_PATH = os.path.join(STATE_DIR, "token")
POLL_INTERVAL = 5
ALPHABET_PASS = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789@#$%"
ALPHABET_OTP = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789"


def load_config() -> dict:
    cfg = {
        "PROVISION_URL": "http://172.16.152.2:8088/api/provision",
        "PROVISION_TOKEN": "viaunix-provision-alterar-em-producao",
        "TIMEOUT": "10",
    }
    if os.path.isfile(CONF_PATH):
        with open(CONF_PATH, "r", encoding="utf-8") as f:
            for raw in f:
                line = raw.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                cfg[k.strip()] = v.strip().strip('"').strip("'")
    cfg["BASE_URL"] = cfg["PROVISION_URL"].split("/api/provision")[0].rstrip("/")
    return cfg


def post_json(url: str, payload: dict, headers: dict, timeout: float = 10.0) -> tuple[int, dict]:
    data = json.dumps(payload).encode("utf-8")
    hdrs = {"Content-Type": "application/json", "Accept": "application/json"}
    hdrs.update(headers)
    req = urllib.request.Request(url, data=data, method="POST", headers=hdrs)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read().decode("utf-8", errors="replace")
            return resp.status, (json.loads(body) if body else {})
    except urllib.error.HTTPError as exc:
        return exc.code, {}
    except (urllib.error.URLError, TimeoutError, OSError, ValueError):
        return 0, {}


def get_primary_mac() -> str:
    for path in sorted(glob.glob("/sys/class/net/*/address")):
        if path.split("/")[-2] == "lo":
            continue
        try:
            mac = open(path, "r", encoding="utf-8").read().strip()
            if mac and mac != "00:00:00:00:00:00":
                return mac
        except OSError:
            pass
    return ""


def get_serial() -> str:
    for p in ("/sys/class/dmi/id/product_serial", "/sys/class/dmi/id/product_uuid"):
        try:
            v = open(p, "r", encoding="utf-8").read().strip()
            if v:
                return v
        except OSError:
            pass
    return ""


def get_local_ip() -> str:
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("172.16.152.2", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except OSError:
        return ""


def get_vpn_ip() -> str:
    try:
        out = subprocess.check_output(["/usr/sbin/ip", "-4", "-o", "addr", "show", "dev", "tun0"], stderr=subprocess.DEVNULL, text=True, timeout=2)
        m = re.search(r"inet\s+([0-9.]+)", out)
        return m.group(1) if m else ""
    except Exception:
        return ""


def get_rustdesk_id() -> str:
    if not shutil.which("rustdesk"):
        return ""
    try:
        out = subprocess.check_output(["rustdesk", "--get-id"], stderr=subprocess.DEVNULL, text=True, timeout=4).strip()
        return out.splitlines()[-1].strip() if out else ""
    except Exception:
        return ""


def get_logged_user() -> str:
    try:
        out = subprocess.check_output(["/usr/bin/who"], text=True, timeout=3)
        users = []
        for line in out.splitlines():
            parts = line.split()
            if parts and parts[0] not in users:
                users.append(parts[0])
        return ", ".join(users[:3])
    except Exception:
        return ""


def get_os_version() -> str:
    try:
        with open("/etc/os-release", "r", encoding="utf-8") as f:
            for line in f:
                if line.startswith("PRETTY_NAME="):
                    return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return "ViaUnix"


def get_cpu_percent() -> float:
    def read_cpu():
        with open("/proc/stat", "r", encoding="utf-8") as f:
            parts = [int(x) for x in f.readline().split()[1:8]]
        return parts[3] + parts[4], sum(parts)
    try:
        i1, t1 = read_cpu()
        time.sleep(0.2)
        i2, t2 = read_cpu()
        dt = t2 - t1
        return round(100.0 * (1.0 - (i2 - i1) / dt), 1) if dt > 0 else 0.0
    except OSError:
        return 0.0


def get_mem_percent() -> float:
    info = {}
    try:
        with open("/proc/meminfo", "r", encoding="utf-8") as f:
            for line in f:
                k, v = line.split(":", 1)
                info[k] = int(v.strip().split()[0])
        total = info.get("MemTotal", 0)
        avail = info.get("MemAvailable", info.get("MemFree", 0))
        return round(100.0 * (1.0 - avail / total), 1) if total > 0 else 0.0
    except Exception:
        return 0.0


def get_disk_percent() -> float:
    try:
        u = shutil.disk_usage("/")
        return round(100.0 * u.used / u.total, 1) if u.total > 0 else 0.0
    except OSError:
        return 0.0


def get_uptime_sec() -> int:
    try:
        return int(float(open("/proc/uptime", "r", encoding="utf-8").read().split()[0]))
    except Exception:
        return 0


def ensure_token(cfg: dict) -> str:
    if os.path.isfile(TOKEN_PATH):
        tok = open(TOKEN_PATH, "r", encoding="utf-8").read().strip()
        if tok:
            return tok

    code, resp = post_json(
        cfg["BASE_URL"] + "/api/agent/register",
        {"hostname": socket.gethostname(), "mac": get_primary_mac(), "serial": get_serial()},
        {"X-ViaUnix-Token": cfg["PROVISION_TOKEN"]},
    )
    if code == 200 and resp.get("agent_token"):
        os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
        os.chmod(STATE_DIR, 0o700)
        fd = os.open(TOKEN_PATH, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(resp["agent_token"] + "\n")
        return resp["agent_token"]
    return ""


def find_graphical_session() -> tuple[str, int, dict]:
    """Localiza o usuario logado no GNOME e extrai o ambiente grafico real do gnome-shell."""
    keep_keys = ("DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR")

    # 1. Metodo mais confiavel: ler /proc/<pid>/environ do gnome-shell do usuario logado
    for pid_dir in glob.glob("/proc/[0-9]*"):
        try:
            comm = open(os.path.join(pid_dir, "comm"), "r", encoding="utf-8").read().strip()
            if comm != "gnome-shell":
                continue
            uid = os.stat(pid_dir).st_uid
            if uid < 1000:
                continue
            pw = pwd.getpwuid(uid)
            raw_env = open(os.path.join(pid_dir, "environ"), "rb").read().split(b"\x00")
            proc_env = {}
            for item in raw_env:
                if b"=" in item:
                    k, v = item.split(b"=", 1)
                    ks = k.decode("utf-8", errors="ignore")
                    if ks in keep_keys:
                        proc_env[ks] = v.decode("utf-8", errors="ignore")
            if proc_env.get("DISPLAY") or proc_env.get("WAYLAND_DISPLAY"):
                proc_env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{uid}")
                proc_env["HOME"] = pw.pw_dir
                proc_env["USER"] = pw.pw_name
                proc_env["PATH"] = "/usr/local/bin:/usr/bin:/bin"
                return pw.pw_name, uid, proc_env
        except OSError:
            continue

    # 2. Fallback via loginctl
    try:
        out = subprocess.check_output(["/bin/loginctl", "list-sessions", "--no-legend"], text=True, timeout=4)
        for line in out.splitlines():
            parts = line.split()
            if len(parts) < 3:
                continue
            sid, uid_s, user = parts[0], parts[1], parts[2]
            if user in ("Debian-gdm", "gdm", "root"):
                continue
            uid = int(uid_s)
            if uid < 1000:
                continue
            pw = pwd.getpwuid(uid)
            props = subprocess.check_output(
                ["/bin/loginctl", "show-session", sid, "-p", "Type", "-p", "State", "-p", "Display"],
                text=True, timeout=3,
            )
            kv = dict(l.split("=", 1) for l in props.splitlines() if "=" in l)
            if kv.get("Type") in ("x11", "wayland") and kv.get("State") == "active":
                env = {
                    "PATH": "/usr/local/bin:/usr/bin:/bin",
                    "HOME": pw.pw_dir,
                    "USER": user,
                    "DISPLAY": kv.get("Display") or ":0",
                    "XDG_RUNTIME_DIR": f"/run/user/{uid}",
                    "DBUS_SESSION_BUS_ADDRESS": f"unix:path=/run/user/{uid}/bus",
                }
                for cand in (f"/run/user/{uid}/gdm/Xauthority", f"{pw.pw_dir}/.Xauthority"):
                    if os.path.isfile(cand):
                        env["XAUTHORITY"] = cand
                        break
                return user, uid, env
    except Exception:
        pass
    return "", -1, {}


def handle_remote_request(cfg: dict, token: str, rreq: dict) -> None:
    sid = rreq["session_id"]
    operator = rreq.get("operator", "Suporte TI")
    reason = rreq.get("reason", "Atendimento de suporte")
    respond_url = f"{cfg['BASE_URL']}/api/agent/remote/{sid}/respond"
    hdr = {"X-Agent-Token": token}

    user, _uid, env = find_graphical_session()
    if not user:
        post_json(respond_url, {"approved": False, "station_user": "", "detail": "nenhum usuario logado na tela"}, hdr)
        return

    try:
        # Passa as variaveis via /usr/bin/env APOS o runuser (runuser limpa DISPLAY/XAUTHORITY por padrao)
        env_args = [f"{k}={v}" for k, v in env.items()]
        res = subprocess.run(
            ["/usr/sbin/runuser", "-u", user, "--", "/usr/bin/env"] + env_args + ["/usr/libexec/viaunix-remote-prompt", operator, reason],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=70,
        )
        approved = (res.returncode == 0)
        err_lines = [l.strip() for l in (res.stderr or "").splitlines() if l.strip()]
        err_tail = " | ".join(err_lines[-2:]) if err_lines else ""
        if err_tail:
            print(f"[viaunix-agent] prompt stderr ({user}): {err_tail}", file=sys.stderr, flush=True)
    except Exception as exc:
        post_json(respond_url, {"approved": False, "station_user": user, "detail": f"erro prompt: {exc}"}, hdr)
        return

    if not approved:
        detail = f"recusado ou expirado ({err_tail[:140]})" if err_tail else "recusado ou expirado"
        post_json(respond_url, {"approved": False, "station_user": user, "detail": detail}, hdr)
        return

    # Usuario autorizou: sobe x11vnc efemero em 127.0.0.1 + tunel WebSocket reverso para o Manager
    otp = "".join(secrets.choice(ALPHABET_OTP) for _ in range(8))

    # Escolhe porta livre em 127.0.0.1
    s_tmp = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s_tmp.bind(("127.0.0.1", 0))
    vnc_port = s_tmp.getsockname()[1]
    s_tmp.close()

    disp = env.get("DISPLAY", ":0")
    xauth = env.get("XAUTHORITY", "")
    vnc_args = [
        "/usr/bin/x11vnc",
        "-localhost",
        "-no6",
        "-noshm",
        "-rfbport", str(vnc_port),
        "-passwd", otp,
        "-display", disp,
        "-noxdamage",
        "-shared",
        "-once",
        "-quiet",
    ]
    if xauth:
        vnc_args += ["-auth", xauth]
    else:
        vnc_args += ["-auth", "guess"]

    env_args = [f"{k}={v}" for k, v in env.items()]
    vnc_cmd = ["/usr/sbin/runuser", "-u", user, "--", "/usr/bin/env"] + env_args + vnc_args
    vnc_proc = subprocess.Popen(vnc_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)

    # Aguarda x11vnc abrir a porta local (ate 5s)
    ready = False
    for _ in range(25):
        if vnc_proc.poll() is not None:
            break
        try:
            c = socket.create_connection(("127.0.0.1", vnc_port), timeout=0.2)
            c.close()
            ready = True
            break
        except OSError:
            time.sleep(0.2)

    if not ready:
        err_v = (vnc_proc.stderr.read() if vnc_proc.stderr else "").strip()
        vnc_proc.terminate()
        post_json(respond_url, {"approved": False, "station_user": user, "detail": f"x11vnc falhou: {err_v[-120:]}"}, hdr)
        return

    post_json(
        respond_url,
        {"approved": True, "station_user": user, "rustdesk_id": "", "otp": otp, "detail": "autorizado pelo usuario (noVNC)"},
        hdr,
    )

    ws_base = cfg["BASE_URL"].replace("https://", "wss://", 1).replace("http://", "ws://", 1)
    ws_url = f"{ws_base}/ws/vnc/agent/{sid}"
    try:
        subprocess.run(["/usr/libexec/viaunix-vnc-tunnel", ws_url, token, str(vnc_port)], timeout=14400)
    finally:
        if vnc_proc.poll() is None:
            vnc_proc.terminate()
            try:
                vnc_proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                vnc_proc.kill()


def run_command(cfg: dict, token: str, cmd: dict) -> None:
    cmd_id = cmd["id"]
    action = cmd["action"]
    payload = cmd.get("payload", "")
    usuario = cmd.get("usuario", "")
    result_url = f"{cfg['BASE_URL']}/api/agent/command/{cmd_id}/result"
    hdr = {"X-Agent-Token": token}
    env = dict(os.environ)
    env["PATH"] = "/usr/sbin:/sbin:/usr/bin:/bin"
    env["DEBIAN_FRONTEND"] = "noninteractive"

    if action == "reboot":
        post_json(result_url, {"status": "done", "output": "Reiniciando estacao..."}, hdr)
        subprocess.Popen(["/bin/systemctl", "reboot"], env=env)
        return

    if action == "shutdown":
        post_json(result_url, {"status": "done", "output": "Desligando estacao..."}, hdr)
        subprocess.Popen(["/bin/systemctl", "poweroff"], env=env)
        return

    if action == "lock_screen":
        res = subprocess.run(["/bin/loginctl", "lock-sessions"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)
        post_json(result_url, {"status": "done" if res.returncode == 0 else "failed", "output": res.stdout or "Sessoes bloqueadas."}, hdr)
        return

    if action == "apt_upgrade":
        res = subprocess.run(
            ["/bin/sh", "-c", "apt-get update && apt-get full-upgrade -y -o Dpkg::Options::=--force-confnew"],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=900, env=env,
        )
        post_json(result_url, {"status": "done" if res.returncode == 0 else "failed", "output": res.stdout[-30000:]}, hdr)
        return

    if action == "rotate_password":
        new_pw = "".join(secrets.choice(ALPHABET_PASS) for _ in range(16))
        new_root = "".join(secrets.choice(ALPHABET_PASS) for _ in range(16))
        ch_in = f"root:{new_root}\n"
        if usuario:
            ch_in = f"{usuario}:{new_pw}\n" + ch_in
        res = subprocess.run(["/usr/sbin/chpasswd"], input=ch_in, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)
        if res.returncode == 0:
            post_json(
                result_url,
                {"status": "done", "output": "Senhas rotacionadas com sucesso.", "new_senha": new_pw, "new_root_senha": new_root},
                hdr,
            )
        else:
            post_json(result_url, {"status": "failed", "output": res.stdout}, hdr)
        return

    if action == "shell":
        try:
            res = subprocess.run(["/bin/sh", "-c", payload], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=120, env=env)
            post_json(result_url, {"status": "done" if res.returncode == 0 else "failed", "output": (res.stdout or "")[-30000:]}, hdr)
        except subprocess.TimeoutExpired:
            post_json(result_url, {"status": "failed", "output": "Tempo limite (120s) excedido."}, hdr)
        return

    post_json(result_url, {"status": "failed", "output": f"Acao desconhecida: {action}"}, hdr)


def main() -> None:
    rd_cache = ""
    tick = 0
    while True:
        cfg = load_config()
        token = ensure_token(cfg)
        if not token:
            time.sleep(POLL_INTERVAL)
            continue

        if tick % 12 == 0 or not rd_cache:
            rd_cache = get_rustdesk_id()
        tick += 1

        hb = {
            "hostname": socket.gethostname(),
            "ip_local": get_local_ip(),
            "vpn_ip": get_vpn_ip(),
            "rustdesk_id": rd_cache,
            "logged_user": get_logged_user(),
            "os_version": get_os_version(),
            "cpu_percent": get_cpu_percent(),
            "mem_percent": get_mem_percent(),
            "disk_percent": get_disk_percent(),
            "uptime_sec": get_uptime_sec(),
        }
        code, resp = post_json(cfg["BASE_URL"] + "/api/agent/heartbeat", hb, {"X-Agent-Token": token})
        if code == 403 and os.path.isfile(TOKEN_PATH):
            os.remove(TOKEN_PATH)
        elif code == 200:
            if resp.get("remote_request"):
                threading.Thread(
                    target=handle_remote_request,
                    args=(cfg, token, resp["remote_request"]),
                    daemon=True,
                ).start()
            if resp.get("command"):
                threading.Thread(
                    target=run_command,
                    args=(cfg, token, resp["command"]),
                    daemon=True,
                ).start()

        time.sleep(POLL_INTERVAL)


if __name__ == "__main__":
    main()

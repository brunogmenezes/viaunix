#!/bin/sh
set -e
if [ "$1" = configure ]; then
    # Garante finais de linha LF e permissao correta
    sed -i 's/\r$//' /etc/nftables.conf 2>/dev/null || true
    chmod 644 /etc/nftables.conf 2>/dev/null || true

    systemctl enable nftables >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then
        if nft -c -f /etc/nftables.conf; then
            systemctl restart nftables
        else
            echo "AVISO: /etc/nftables.conf com erro de sintaxe; verifique com: nft -c -f /etc/nftables.conf" >&2
        fi
    fi
fi
exit 0

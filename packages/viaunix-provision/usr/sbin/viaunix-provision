#!/usr/bin/env python3
"""ViaUnix - provisionamento automatico (instalacao nova ou VM ja instalada).

Modos:
  (padrao)    Executado pelo Calamares na instalacao nova.
  --existing  Executado pelo postinst em VMs ja instaladas: gera usuario/senhas/hostname
              aleatorios unicos, envia ao servidor e, apos confirmacao (201), trava
              senhas locais de contas sudo antigas.
  --retry     Executado no boot (viaunix-provision-retry.service) se estava offline.
"""

import datetime
import glob
import grp
import json
import os
import secrets
import socket
import subprocess
import sys
import urllib.error
import urllib.request

CONF_PATH = "/etc/viaunix/provision.conf"
STATE_DIR = "/var/lib/viaunix-provision"
PENDING_PATH = os.path.join(STATE_DIR, "pending.json")
MARKER_PATH = os.path.join(STATE_DIR, "provisioned")

ALPHABET_USER = "abcdefghjkmnpqrstuvwxyz23456789"
ALPHABET_PASS = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789@#$%"


def load_config() -> dict:
    cfg = {
        "PROVISION_URL": "http://172.16.152.2:8088/api/provision",
        "PROVISION_TOKEN": "viaunix-provision-alterar-em-producao",
        "TIMEOUT": "15",
    }
    if os.path.isfile(CONF_PATH):
        with open(CONF_PATH, "r", encoding="utf-8") as f:
            for raw in f:
                line = raw.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                cfg[k.strip()] = v.strip().strip('"').strip("'")
    return cfg


def get_primary_mac() -> str:
    for path in sorted(glob.glob("/sys/class/net/*/address")):
        iface = path.split("/")[-2]
        if iface == "lo":
            continue
        try:
            mac = open(path, "r", encoding="utf-8").read().strip()
            if mac and mac != "00:00:00:00:00:00":
                return mac
        except OSError:
            pass
    return ""


def get_serial() -> str:
    for path in ("/sys/class/dmi/id/product_serial", "/sys/class/dmi/id/product_uuid"):
        try:
            val = open(path, "r", encoding="utf-8").read().strip()
            if val:
                return val
        except OSError:
            pass
    return ""


def generate_credentials() -> dict:
    host_suffix = secrets.token_hex(3)
    user_suffix = "".join(secrets.choice(ALPHABET_USER) for _ in range(6))
    password = "".join(secrets.choice(ALPHABET_PASS) for _ in range(16))
    root_password = "".join(secrets.choice(ALPHABET_PASS) for _ in range(16))
    return {
        "hostname": f"viaunix-{host_suffix}",
        "usuario": f"adm-{user_suffix}",
        "senha": password,
        "root_senha": root_password,
        "mac": get_primary_mac(),
        "serial": get_serial(),
        "instalado_em": datetime.datetime.now(datetime.timezone.utc).astimezone().isoformat(timespec="seconds"),
    }


def send_to_server(cfg: dict, record: dict) -> str:
    """Retorna 'ok', 'conflict' ou 'network_error'."""
    body = json.dumps(record).encode("utf-8")
    req = urllib.request.Request(
        cfg["PROVISION_URL"],
        data=body,
        method="POST",
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-ViaUnix-Token": cfg["PROVISION_TOKEN"],
        },
    )
    timeout = float(cfg.get("TIMEOUT", "15") or "15")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return "ok" if 200 <= resp.status < 300 else "network_error"
    except urllib.error.HTTPError as exc:
        if exc.code == 409:
            return "conflict"
        print(f"[viaunix-provision] servidor retornou HTTP {exc.code}", file=sys.stderr)
        return "network_error"
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        print(f"[viaunix-provision] servidor indisponivel: {exc}", file=sys.stderr)
        return "network_error"


def save_json(path: str, data: dict) -> None:
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)


def lock_old_sudo_users(keep_user: str) -> None:
    """Trava a senha local de usuarios sudo antigos (ex: conta criada na instalacao antiga)."""
    env = dict(os.environ)
    env["PATH"] = "/usr/sbin:/sbin:/usr/bin:/bin"
    try:
        sudo_members = list(grp.getgrnam("sudo").gr_mem)
    except KeyError:
        return
    for old_user in sudo_members:
        if old_user in ("root", keep_user):
            continue
        subprocess.run(["/usr/bin/passwd", "-l", old_user], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)
        print(f"[viaunix-provision] senha local antiga travada para '{old_user}'.")


def apply_local_system(record: dict, live_system: bool) -> None:
    hostname = record["hostname"]
    user = record["usuario"]
    password = record["senha"]
    root_password = record["root_senha"]

    with open("/etc/hostname", "w", encoding="utf-8") as f:
        f.write(f"{hostname}\n")

    hosts_lines = [
        "127.0.0.1\tlocalhost\n",
        f"127.0.1.1\t{hostname}\n",
        "::1\tlocalhost ip6-localhost ip6-loopback\n",
        "ff02::1\tip6-allnodes\n",
        "ff02::2\tip6-allrouters\n",
    ]
    with open("/etc/hosts", "w", encoding="utf-8") as f:
        f.writelines(hosts_lines)

    env = dict(os.environ)
    env["PATH"] = "/usr/sbin:/sbin:/usr/bin:/bin"

    if live_system:
        subprocess.run(["/usr/bin/hostnamectl", "set-hostname", hostname], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)

    subprocess.run(
        ["/usr/sbin/useradd", "-m", "-s", "/bin/bash", "-G", "sudo,adm", user],
        check=True,
        env=env,
    )
    chpasswd_input = f"{user}:{password}\nroot:{root_password}\n"
    subprocess.run(
        ["/usr/sbin/chpasswd"],
        input=chpasswd_input,
        text=True,
        check=True,
        env=env,
    )

    for gdm_cfg in ("/etc/gdm3/daemon.conf", "/etc/gdm3/custom.conf"):
        if os.path.isfile(gdm_cfg):
            with open(gdm_cfg, "r", encoding="utf-8") as f:
                content = f.read()
            if "AutomaticLoginEnable=true" in content:
                content = content.replace("AutomaticLoginEnable=true", "AutomaticLoginEnable=false")
                with open(gdm_cfg, "w", encoding="utf-8") as f:
                    f.write(content)


def run_retry(cfg: dict) -> int:
    if not os.path.isfile(PENDING_PATH):
        return 0
    with open(PENDING_PATH, "r", encoding="utf-8") as f:
        record = json.load(f)
    status = send_to_server(cfg, record)
    if status in ("ok", "conflict"):
        os.remove(PENDING_PATH)
        if record.get("lock_old_after_send"):
            lock_old_sudo_users(record["usuario"])
        print("[viaunix-provision] credenciais pendentes enviadas ao servidor.")
        return 0
    return 1


def main() -> int:
    cfg = load_config()
    mode = sys.argv[1] if len(sys.argv) > 1 else ""

    if mode == "--retry":
        return run_retry(cfg)

    existing_mode = (mode == "--existing")

    record = None
    sent = False
    for _ in range(5):
        candidate = generate_credentials()
        status = send_to_server(cfg, candidate)
        if status == "ok":
            record = candidate
            sent = True
            break
        if status == "conflict":
            continue
        record = candidate
        sent = False
        break

    if record is None:
        record = generate_credentials()

    apply_local_system(record, live_system=existing_mode)

    # Marca a maquina como provisionada (sem guardar senha no marcador)
    save_json(MARKER_PATH, {
        "hostname": record["hostname"],
        "usuario": record["usuario"],
        "provisionado_em": record["instalado_em"],
        "enviado": sent,
    })

    if sent:
        if existing_mode:
            # Somente trava contas admin antigas APOS confirmacao do servidor
            lock_old_sudo_users(record["usuario"])
        print(f"[viaunix-provision] maquina '{record['hostname']}' ({record['usuario']}) registrada no servidor.")
    else:
        if existing_mode:
            record["lock_old_after_send"] = True
        save_json(PENDING_PATH, record)
        print("[viaunix-provision] aviso: servidor inacessivel; salvo para reenvio automatico no proximo boot.")
    return 0


if __name__ == "__main__":
    sys.exit(main())

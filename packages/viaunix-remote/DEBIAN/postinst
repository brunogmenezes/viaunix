#!/bin/sh
set -e
if [ "$1" = configure ]; then
    # 1. Remove/desativa agentes antigos (MeshCentral e RustDesk)
    if systemctl is-active --quiet meshagent.service 2>/dev/null || [ -x /usr/local/mesh_services/meshagent/meshagent ]; then
        systemctl stop meshagent.service >/dev/null 2>&1 || true
        systemctl disable meshagent.service >/dev/null 2>&1 || true
        /usr/local/mesh_services/meshagent/meshagent -fulluninstall >/dev/null 2>&1 || true
    fi
    if systemctl is-active --quiet rustdesk.service 2>/dev/null || systemctl is-enabled --quiet rustdesk.service 2>/dev/null; then
        systemctl stop rustdesk.service >/dev/null 2>&1 || true
        systemctl disable rustdesk.service >/dev/null 2>&1 || true
    fi

    # 2. Mantem X11 no GDM para captura de tela limpa pelo x11vnc
    for f in /etc/gdm3/daemon.conf /etc/gdm3/custom.conf; do
        if [ -f "$f" ]; then
            if grep -qE "^[#[:space:]]*WaylandEnable=" "$f"; then
                sed -i -E 's|^[#[:space:]]*WaylandEnable=.*|WaylandEnable=false|' "$f"
            elif grep -q "^\[daemon\]" "$f"; then
                sed -i '/^\[daemon\]/a WaylandEnable=false' "$f"
            else
                printf '\n[daemon]\nWaylandEnable=false\n' >> "$f"
            fi
        fi
    done
fi
exit 0

#!/bin/sh
# Aplica servidor e chave publica do RustDesk em /root, /etc/skel e todos os /home/* existentes
set -e
CONF=/etc/viaunix/rustdesk.conf
[ -f "$CONF" ] || exit 0
. "$CONF"
[ -n "${RUSTDESK_SERVER:-}" ] || exit 0

write_toml() {
    dir="$1"
    owner="$2"
    mkdir -p "$dir"
    cat > "$dir/RustDesk2.toml" <<EOF
rendezvous_server = '${RUSTDESK_SERVER}:21116'
nat_type = 1
serial = 0

[options]
custom-rendezvous-server = '${RUSTDESK_SERVER}'
relay-server = '${RUSTDESK_SERVER}'
key = '${RUSTDESK_KEY}'
verification-method = 'use-both-passwords'
approve-mode = 'password'
EOF
    if [ -n "$owner" ]; then
        chown -R "$owner:$owner" "$(dirname "$dir")" 2>/dev/null || chown -R "$owner" "$dir" 2>/dev/null || true
    fi
}

write_toml /root/.config/rustdesk ""
write_toml /etc/skel/.config/rustdesk ""
chmod 644 /etc/skel/.config/rustdesk/RustDesk2.toml

for h in /home/*; do
    [ -d "$h" ] || continue
    u=$(basename "$h")
    id "$u" >/dev/null 2>&1 || continue
    write_toml "$h/.config/rustdesk" "$u"
done

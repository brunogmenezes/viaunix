#!/bin/sh
# Instala ou atualiza o agente MeshCentral na estacao ViaUnix usando /etc/viaunix/meshcentral.conf
set -e

CONF=/etc/viaunix/meshcentral.conf
[ -f "$CONF" ] || exit 0
. "$CONF"

[ -n "${MESH_ID:-}" ] || exit 0
[ -n "${MESHCENTRAL_URL:-}" ] || exit 0

MSH=/usr/local/mesh_services/meshagent/meshagent.msh
# Se ja esta instalado com wss:// (TLS valido na agentPort), nao reinstala
if systemctl is-active --quiet meshagent.service 2>/dev/null && [ -f "$MSH" ] && grep -q "^MeshServer=wss://" "$MSH"; then
    exit 0
fi

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

curl -fsSLk "${MESHCENTRAL_URL}/meshagents?script=1" -o "$TMP/meshinstall.sh"
chmod +x "$TMP/meshinstall.sh"
bash "$TMP/meshinstall.sh" "${MESHCENTRAL_URL}" "${MESH_ID}"

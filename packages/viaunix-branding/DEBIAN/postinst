#!/bin/sh
set -e
if [ "$1" = configure ]; then
    # Atualiza tambem /etc/gdm3/greeter.dconf-defaults (usado pelo gdm3 no Debian 13)
    if [ -f /etc/gdm3/greeter.dconf-defaults ]; then
        sed -i -E \
            -e "s|^[#[:space:]]*logo=.*|logo='/usr/share/pixmaps/viaunix-gdm-logo.png'|" \
            -e "s|^[#[:space:]]*disable-user-list=.*|disable-user-list=true|" \
            /etc/gdm3/greeter.dconf-defaults
        if ! grep -q "^disable-user-list=true" /etc/gdm3/greeter.dconf-defaults; then
            printf '\n[org/gnome/login-screen]\nlogo='\''/usr/share/pixmaps/viaunix-gdm-logo.png'\''\ndisable-user-list=true\n' >> /etc/gdm3/greeter.dconf-defaults
        fi
    fi

    # Recompila a base dconf do sistema e do GDM
    dconf update || true
    if [ -x /usr/share/gdm/generate-config ]; then
        /usr/share/gdm/generate-config || true
    fi
    if [ -d /usr/share/gdm/dconf ] && [ -f /var/lib/gdm3/greeter-dconf-defaults ]; then
        dconf compile /var/lib/gdm3/greeter-dconf-defaults /usr/share/gdm/dconf || true
    fi

    # Aplica papel de parede no fundo da tela de login GDM
    if [ -x /usr/libexec/viaunix-gdm-theme ]; then
        /usr/libexec/viaunix-gdm-theme || true
    fi

    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
        plymouth-set-default-theme viaunix || true
        update-initramfs -u || true
    fi
    if command -v update-grub >/dev/null 2>&1; then
        update-grub || true
    fi
fi
exit 0

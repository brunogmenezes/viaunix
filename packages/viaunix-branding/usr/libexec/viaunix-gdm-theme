#!/bin/sh
# ViaUnix - aplica o papel de parede do ViaUnix tambem no fundo da tela de login (GDM)
# Compila um gresource proprio a partir do tema do GNOME Shell instalado.
set -e

WALL="/usr/share/backgrounds/viaunix/viaunix-wallpaper.png"
SRC_GRES="/usr/share/gnome-shell/gnome-shell-theme.gresource"
ORIG_GRES="/usr/share/gnome-shell/gnome-shell-theme.gresource.distrib"
OUT_GRES="/usr/share/gnome-shell/viaunix-gdm-theme.gresource"

[ -f "$WALL" ] || exit 0
command -v gresource >/dev/null 2>&1 || exit 0
command -v glib-compile-resources >/dev/null 2>&1 || exit 0

BASE_GRES="$SRC_GRES"
[ -f "$ORIG_GRES" ] && BASE_GRES="$ORIG_GRES"
[ -f "$BASE_GRES" ] || exit 0

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

mkdir -p "$TMP/theme"
XML="$TMP/theme/viaunix-gdm-theme.gresource.xml"

cat > "$XML" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<gresources>
  <gresource prefix="/org/gnome/shell/theme">
EOF

for r in $(gresource list "$BASE_GRES"); do
    rel="${r#/org/gnome/shell/theme/}"
    [ "$rel" = "$r" ] && continue
    mkdir -p "$TMP/theme/$(dirname "$rel")"
    gresource extract "$BASE_GRES" "$r" > "$TMP/theme/$rel"
    printf '    <file>%s</file>\n' "$rel" >> "$XML"
done

cp "$WALL" "$TMP/theme/viaunix-wallpaper.png"
printf '    <file>viaunix-wallpaper.png</file>\n' >> "$XML"

cat >> "$XML" <<'EOF'
  </gresource>
</gresources>
EOF

for css in "$TMP/theme/gnome-shell.css" "$TMP/theme/gnome-shell-high-contrast.css"; do
    if [ -f "$css" ]; then
        cat >> "$css" <<'EOF'

/* ViaUnix - fundo da tela de login GDM */
#lockDialogGroup {
  background: #0e284e url("resource:///org/gnome/shell/theme/viaunix-wallpaper.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
EOF
    fi
done

glib-compile-resources --sourcedir="$TMP/theme" --target="$OUT_GRES" "$XML"
chmod 644 "$OUT_GRES"

# 1. Tenta update-alternatives (gdm-theme.gresource ou gdm3-theme.gresource)
if update-alternatives --query gdm-theme.gresource >/dev/null 2>&1; then
    update-alternatives --install /usr/share/gnome-shell/gdm-theme.gresource gdm-theme.gresource "$OUT_GRES" 100
    update-alternatives --set gdm-theme.gresource "$OUT_GRES"
elif update-alternatives --query gdm3-theme.gresource >/dev/null 2>&1; then
    update-alternatives --install /usr/share/gnome-shell/gdm3-theme.gresource gdm3-theme.gresource "$OUT_GRES" 100
    update-alternatives --set gdm3-theme.gresource "$OUT_GRES"
else
    # 2. Fallback seguro via dpkg-divert sobre gnome-shell-theme.gresource
    if ! dpkg-divert --list "$SRC_GRES" | grep -q "viaunix-branding"; then
        dpkg-divert --package viaunix-branding --add --rename --divert "$ORIG_GRES" "$SRC_GRES"
    fi
    ln -sf "$OUT_GRES" "$SRC_GRES"
fi

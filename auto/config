#!/bin/sh
# ViaUnix - configuração do live-build (base: Debian 13 "trixie")
set -e

lb config noauto \
    --distribution trixie \
    --architectures amd64 \
    --archive-areas "main contrib non-free-firmware" \
    --parent-archive-areas "main contrib non-free-firmware" \
    --debian-installer none \
    --binary-images iso-hybrid \
    --bootappend-live "boot=live components quiet splash locales=pt_BR.UTF-8 keyboard-layouts=br timezone=America/Sao_Paulo username=viaunix" \
    --iso-application "ViaUnix" \
    --iso-volume "ViaUnix 1" \
    --iso-publisher "ViaUnix Project" \
    --image-name "viaunix" \
    --apt-indices false \
    "${@}"
